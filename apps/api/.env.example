PORT=3000
# Obrigatório em produção (NODE_ENV=production)
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
# Validade do token de acesso em segundos
JWT_EXPIRES_IN=3600
# Conexão com o SQL Server do compose.yaml da raiz (use a mesma senha de MSSQL_SA_PASSWORD).
# trustServerCertificate=true aceita o certificado autoassinado do container; não use em produção.
DATABASE_URL="sqlserver://localhost:1433;database=codeconnect;user=sa;password=Troque-esta-Senha1;encrypt=true;trustServerCertificate=true"
# Opcional: banco dos testes e2e. Sem ela, usa DATABASE_URL com database=codeconnect_test.
# DATABASE_URL_TEST="sqlserver://localhost:1433;database=codeconnect_test;user=sa;password=Troque-esta-Senha1;encrypt=true;trustServerCertificate=true"
